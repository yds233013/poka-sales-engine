# Copy to .env for local development. Names and safe defaults only — never
# commit real values. See docs/DEPLOYMENT.md for the production settings.

# ── Database (required) ─────────────────────────────────────────────────────
# Local: matches the docker-compose service (demo credentials, local only).
# Production: set by the platform's managed PostgreSQL. Keep it secret.
DATABASE_URL="postgresql://poka:poka@localhost:5433/poka_sales_engine?schema=public"

# Optional, tests only. The integration suite creates and drops its own
# database; by default it derives the name poka_sales_engine_test from
# DATABASE_URL. Never point this at a database you want to keep.
# TEST_DATABASE_URL=""

# ── Request understanding (required) ────────────────────────────────────────
# "mock" — the deterministic extractor. Use it everywhere, including
# production. Pricing, stock, compatibility and approvals are deterministic
# regardless of this setting.
AI_PROVIDER="mock"

# ── Live adaptive agent (optional) ──────────────────────────────────────────
# Only needed to run the adaptive agent against a real model. Without it the
# product still works fully and shows the captured live runs. Leave it unset
# on a public deployment.
ANTHROPIC_API_KEY=""
# Model for live runs. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Public demo controls (production) ───────────────────────────────────────
# PUBLIC_DEMO=true makes the deployment read-only for visitors: every server
# action that would change the shared data is refused, live model runs are
# off even if a key is present, and the evaluation suite cannot be started.
# Leave it unset locally so every action works.
PUBLIC_DEMO=""
# Re-enables live model runs on a public demo. Only behind authentication,
# with ADAPTIVE_MAX_RUNS_PER_HOUR set and a spend limit on the API workspace.
ALLOW_LIVE_ADAPTIVE=""
# Per-process cap on live runs per hour. Empty means no cap.
ADAPTIVE_MAX_RUNS_PER_HOUR=""
