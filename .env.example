# ── Database ────────────────────────────────────────────────────────────────
# Matches the docker-compose service below. Point this anywhere a Postgres 14+
# instance lives (a local Homebrew install works too).
DATABASE_URL="postgresql://poka:poka@localhost:5433/poka_sales_engine?schema=public"

# ── AI provider ─────────────────────────────────────────────────────────────
# "mock"      — deterministic local provider. Default. No API key, no network.
#               The full workflow runs end to end in this mode.
# "anthropic" — uses the Claude API for the language-shaped steps only
#               (request analysis, evidence summarisation, response drafting).
#               All pricing, inventory, compatibility and approval logic stays
#               deterministic regardless of this setting.
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Public deployment ───────────────────────────────────────────────────────
# See docs/DEPLOYMENT.md. On a public link, set PUBLIC_DEMO=true: live model
# runs are then refused even if a key is present, and the captured live runs
# are shown instead. ALLOW_LIVE_ADAPTIVE=true re-enables them deliberately —
# only behind authentication, with ADAPTIVE_MAX_RUNS_PER_HOUR set.
PUBLIC_DEMO=""
ALLOW_LIVE_ADAPTIVE=""
ADAPTIVE_MAX_RUNS_PER_HOUR=""
