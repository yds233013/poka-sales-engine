// Poka Sales Engine — relational schema
// Domain: industrial process pumps, drives and accessories (synthetic data).
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

enum UserRole {
  SALES_REP
  SALES_MANAGER
  APPLICATION_ENGINEER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole
  title     String
  initials  String
  createdAt DateTime @default(now())

  ownedRequests   SalesRequest[] @relation("RequestOwner")
  approvalsRaised Approval[]     @relation("ApprovalRequester")
  approvalsActed  Approval[]     @relation("ApprovalDecider")
  auditEvents     AuditEvent[]

  @@map("users")
}

// ───────────────────────────── Customers ────────────────────────────

enum CustomerTier {
  STRATEGIC
  KEY
  STANDARD
  TRANSACTIONAL
}

model Customer {
  id            String       @id @default(cuid())
  accountNumber String       @unique
  name          String
  legalName     String
  industry      String
  tier          CustomerTier
  /// Net payment terms in days.
  paymentTerms  Int
  creditLimit   Decimal      @db.Decimal(14, 2)
  /// Currency ISO code — single currency (USD) in this demo build.
  currency      String       @default("USD")
  priceBookId   String?
  notes         String?
  createdAt     DateTime     @default(now())

  priceBook       PriceBook?       @relation(fields: [priceBookId], references: [id])
  sites           CustomerSite[]
  contacts        Contact[]
  customerPricing CustomerPricing[]
  requests        SalesRequest[]
  quotes          Quote[]

  @@index([name])
  @@map("customers")
}

model CustomerSite {
  id           String  @id @default(cuid())
  customerId   String
  name         String
  /// Free-text plant/line identifiers the customer uses in emails ("Line 4").
  aliases      String[]
  addressLine1 String
  city         String
  state        String
  postalCode   String
  country      String  @default("US")
  freightZone  String
  isPrimary    Boolean @default(false)

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contacts Contact[]
  requests SalesRequest[]
  quotes   Quote[]

  @@index([customerId])
  @@map("customer_sites")
}

model Contact {
  id         String  @id @default(cuid())
  customerId String
  siteId     String?
  name       String
  email      String
  phone      String?
  jobTitle   String

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site     CustomerSite?  @relation(fields: [siteId], references: [id])
  requests SalesRequest[]

  @@index([customerId])
  @@map("contacts")
}

// ───────────────────────────── Catalog ──────────────────────────────

model ProductCategory {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  family      String
  description String

  products Product[]

  @@map("product_categories")
}

enum LifecycleStatus {
  ACTIVE
  MATURE
  END_OF_LIFE
  DISCONTINUED
}

model Product {
  id              String          @id @default(cuid())
  sku             String          @unique
  name            String
  categoryId      String
  description     String
  lifecycle       LifecycleStatus @default(ACTIVE)
  /// Standard factory lead time (days) when stock is unavailable.
  leadTimeDays    Int
  listPrice       Decimal         @db.Decimal(12, 2)
  /// Landed/standard cost — internal only, never surfaced to customers.
  standardCost    Decimal         @db.Decimal(12, 2)
  weightKg        Decimal         @db.Decimal(10, 2)
  /// True for adapters, seal kits, flange sets etc.
  isAccessory     Boolean         @default(false)
  hazmat          Boolean         @default(false)
  createdAt       DateTime        @default(now())

  category         ProductCategory   @relation(fields: [categoryId], references: [id])
  specs            ProductSpec[]
  inventory        Inventory[]
  priceBookEntries PriceBookEntry[]
  customerPricing  CustomerPricing[]
  documents        TechnicalDocument[]
  substitutesFrom  SubstitutionLink[] @relation("SubFrom")
  substitutesTo    SubstitutionLink[] @relation("SubTo")
  requestItems     RequestItem[]
  quoteItems       QuoteItem[]
  candidates       RecommendationCandidate[]
  accessoryOf      AccessoryLink[]    @relation("AccessoryPart")
  requiresAcc      AccessoryLink[]    @relation("AccessoryHost")

  @@index([categoryId])
  @@map("products")
}

enum SpecType {
  NUMERIC
  RANGE
  ENUM
  BOOLEAN
  TEXT
}

/// One technical attribute of a product. Numeric specs carry units so the
/// compatibility engine can compare them without parsing free text.
model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  key       String
  label     String
  type      SpecType
  numValue  Decimal? @db.Decimal(14, 4)
  minValue  Decimal? @db.Decimal(14, 4)
  maxValue  Decimal? @db.Decimal(14, 4)
  textValue String?
  boolValue Boolean?
  unit      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([key])
  @@map("product_specs")
}

enum SubstitutionKind {
  DIRECT_REPLACEMENT
  SUCCESSOR
  UPGRADE
  ALTERNATE
  ACCESSORY_REQUIRED
}

/// Curated engineering relationship between two products. The compatibility
/// engine still re-validates specs — this only narrows the candidate set.
model SubstitutionLink {
  id            String           @id @default(cuid())
  fromProductId String
  toProductId   String
  kind          SubstitutionKind
  /// Engineering note shown in the UI alongside the automated checks.
  note          String
  /// Accessory SKU that must be added for the substitution to be valid.
  requiresSku   String?

  fromProduct Product @relation("SubFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct   Product @relation("SubTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@unique([fromProductId, toProductId])
  @@map("substitution_links")
}

model AccessoryLink {
  id          String  @id @default(cuid())
  hostId      String
  accessoryId String
  required    Boolean @default(false)
  reason      String

  host      Product @relation("AccessoryHost", fields: [hostId], references: [id], onDelete: Cascade)
  accessory Product @relation("AccessoryPart", fields: [accessoryId], references: [id], onDelete: Cascade)

  @@unique([hostId, accessoryId])
  @@map("accessory_links")
}

enum RuleSeverity {
  HARD
  SOFT
}

enum RuleOperator {
  GTE
  LTE
  EQ
  NEQ
  INCLUDES
  WITHIN_TOLERANCE
}

/// Declarative compatibility rules. Each rule compares one requirement
/// dimension against one product spec key. HARD failures block a
/// recommendation outright; SOFT failures raise a warning for human review.
model CompatibilityRule {
  id            String       @id @default(cuid())
  code          String       @unique
  dimension     String
  label         String
  /// Spec key on the candidate product that this rule reads.
  specKey       String
  /// Requirement key extracted from the customer request.
  requirementKey String
  operator      RuleOperator
  severity      RuleSeverity
  /// Percentage tolerance for WITHIN_TOLERANCE comparisons.
  tolerancePct  Decimal?     @db.Decimal(6, 2)
  /// Only applies to products in these categories; empty = all.
  appliesTo     String[]
  explanation   String

  @@map("compatibility_rules")
}

// ───────────────────── Technical documentation ──────────────────────

enum DocType {
  SPEC_SHEET
  INSTALLATION_GUIDE
  COMPATIBILITY_NOTE
  REPLACEMENT_GUIDE
  TECHNICAL_BULLETIN
  SAFETY_NOTICE
}

model TechnicalDocument {
  id          String   @id @default(cuid())
  docNumber   String   @unique
  title       String
  type        DocType
  revision    String
  publishedAt DateTime
  productId   String?
  /// Families this doc covers when it is not tied to a single SKU.
  families    String[]
  summary     String

  product  Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sections DocumentSection[]

  @@index([type])
  @@map("technical_documents")
}

/// A citable chunk of a document. Evidence references point at a section,
/// so every claim in a recommendation resolves to real seeded text.
model DocumentSection {
  id         String @id @default(cuid())
  documentId String
  /// e.g. "3.2" — rendered in citations as DOC-1042 §3.2.
  anchor     String
  heading    String
  body       String
  ordinal    Int

  document TechnicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@unique([documentId, anchor])
  @@map("document_sections")
}

// ───────────────────────────── Inventory ────────────────────────────

model Warehouse {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  city        String
  state       String
  country     String  @default("US")
  freightZone String
  /// Days to pick/pack before a shipment leaves the dock.
  handlingDays Int    @default(1)

  inventory Inventory[]

  @@map("warehouses")
}

model Inventory {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  onHand      Int
  /// Allocated to other open orders — not available to promise.
  reserved    Int    @default(0)
  /// Reorder trigger, shown to operators as context.
  safetyStock Int    @default(0)

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  incoming  IncomingShipment[]

  @@unique([productId, warehouseId])
  @@map("inventory")
}

model IncomingShipment {
  id           String   @id @default(cuid())
  inventoryId  String
  quantity     Int
  expectedAt   DateTime
  poNumber     String
  confirmed    Boolean  @default(true)

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@map("incoming_shipments")
}

// ───────────────────────────── Pricing ──────────────────────────────

model PriceBook {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String
  /// Default discount off list for products in this book.
  defaultDiscountPct Decimal @db.Decimal(6, 2)

  entries   PriceBookEntry[]
  customers Customer[]

  @@map("price_books")
}

model PriceBookEntry {
  id          String  @id @default(cuid())
  priceBookId String
  productId   String
  discountPct Decimal @db.Decimal(6, 2)

  priceBook PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceBookId, productId])
  @@map("price_book_entries")
}

/// Negotiated contract price for a specific customer + SKU. Takes precedence
/// over price book discounts when active.
model CustomerPricing {
  id           String    @id @default(cuid())
  customerId   String
  productId    String
  contractPrice Decimal  @db.Decimal(12, 2)
  contractRef  String
  effectiveFrom DateTime
  effectiveTo   DateTime

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@map("customer_pricing")
}

/// Volume break: qty >= minQty earns an additional discount off list.
model DiscountRule {
  id          String  @id @default(cuid())
  code        String  @unique
  scope       String
  /// Category code the break applies to, or null for all products.
  categoryCode String?
  minQty      Int
  discountPct Decimal @db.Decimal(6, 2)
  description String

  @@map("discount_rules")
}

enum FreightService {
  GROUND
  EXPEDITED
  AIR
}

model FreightRule {
  id            String         @id @default(cuid())
  code          String         @unique
  originZone    String
  destZone      String
  service       FreightService
  baseCharge    Decimal        @db.Decimal(10, 2)
  perKg         Decimal        @db.Decimal(10, 4)
  transitDays   Int
  /// Surcharge applied when any line is flagged hazmat.
  hazmatSurcharge Decimal      @db.Decimal(10, 2) @default(0)

  @@unique([originZone, destZone, service])
  @@map("freight_rules")
}

/// Commercial guardrails evaluated by the approval engine.
model PolicyThreshold {
  id          String  @id @default(cuid())
  code        String  @unique
  label       String
  numericValue Decimal @db.Decimal(12, 2)
  unit        String
  description String

  @@map("policy_thresholds")
}

// ─────────────────────── Requests / cases ───────────────────────────

enum RequestStatus {
  NEW
  ANALYZING
  NEEDS_REVIEW
  READY_FOR_APPROVAL
  APPROVED
  RESPONSE_READY
  COMPLETED
  BLOCKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum RequestChannel {
  EMAIL
  PORTAL
  PHONE
  EDI
}

model SalesRequest {
  id           String         @id @default(cuid())
  reference    String         @unique
  subject      String
  rawBody      String
  channel      RequestChannel @default(EMAIL)
  status       RequestStatus  @default(NEW)
  risk         RiskLevel      @default(LOW)
  receivedAt   DateTime
  /// Customer-stated delivery deadline, once extracted.
  requiredBy   DateTime?
  customerId   String?
  siteId       String?
  contactId    String?
  ownerId      String?
  /// Short operator-facing summary produced by the analysis step.
  summary      String?
  /// Set when the workflow cannot proceed safely.
  blockedReason String?
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())

  customer        Customer?      @relation(fields: [customerId], references: [id])
  site            CustomerSite?  @relation(fields: [siteId], references: [id])
  contact         Contact?       @relation(fields: [contactId], references: [id])
  owner           User?          @relation("RequestOwner", fields: [ownerId], references: [id])
  items           RequestItem[]
  requirements    Requirement[]
  runs            AgentRun[]
  recommendations Recommendation[]
  quotes          Quote[]
  approvals       Approval[]
  auditEvents     AuditEvent[]
  responses       CustomerResponse[]

  @@index([status])
  @@index([customerId])
  @@map("sales_requests")
}

model RequestItem {
  id          String  @id @default(cuid())
  requestId   String
  /// SKU exactly as the customer wrote it, before resolution.
  rawText     String
  productId   String?
  quantity    Int
  lineNumber  Int

  request SalesRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id])

  @@index([requestId])
  @@map("request_items")
}

enum RequirementKind {
  EXPLICIT
  INFERRED
  AMBIGUOUS
  MISSING
}

/// A single structured requirement extracted from the request text.
model Requirement {
  id         String          @id @default(cuid())
  requestId  String
  key        String
  label      String
  kind       RequirementKind
  operator   RuleOperator?
  numValue   Decimal?        @db.Decimal(14, 4)
  textValue  String?
  unit       String?
  /// Verbatim snippet from the customer message that produced this.
  sourceQuote String?
  /// 0-1; low confidence surfaces in the UI as an open question.
  confidence Decimal         @db.Decimal(4, 3)
  note       String?

  request SalesRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("requirements")
}

// ─────────────────────── Agent run + tool calls ─────────────────────

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
  HALTED_FOR_APPROVAL
}

/// How a run was orchestrated. Both modes use the same engines, the same
/// catalog and the same approval policy — only the orchestration differs.
/// Where a run's model turns came from. The UI must never present a scripted
/// test run as a live agent result, and `mode` alone cannot tell them apart —
/// both record ADAPTIVE_AGENT with a model name.
enum ModelSource {
  /// Deterministic run. No model directed anything.
  NONE
  /// A scripted stand-in supplied by a test or fixture.
  SCRIPTED
  /// A real provider call.
  LIVE
}

enum ExecutionMode {
  /// Fixed tool pipeline. Offline, reproducible, always available.
  DETERMINISTIC
  /// Model-directed tool selection over MCP. Requires provider credentials.
  ADAPTIVE_AGENT
}

/// Where an adaptive run ended up. Deterministic runs record COMPLETED.
enum TerminationStatus {
  COMPLETED
  READY_FOR_APPROVAL
  READY_TO_DRAFT
  NEEDS_CUSTOMER_CLARIFICATION
  NEEDS_INTERNAL_REVIEW
  BLOCKED_TECHNICAL
  /// A guardrail stopped the run — turn cap, tool cap, timeout or a loop.
  GUARDRAIL_STOP
  FAILED
}

model AgentRun {
  id          String        @id @default(cuid())
  requestId   String
  status      RunStatus     @default(RUNNING)
  mode        ExecutionMode @default(DETERMINISTIC)
  /// "mock" or the model id when a real provider is configured.
  provider    String
  /// Model identifier for an adaptive run; null for deterministic.
  model       String?
  modelSource ModelSource @default(NONE)
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  error       String?
  /// Coarse failure bucket, for the eval harness. Never a stack trace.
  errorCategory String?
  /// Operator-readable narrative steps (no chain-of-thought).
  trace       Json?

  // ── Adaptive-run observability. Null on deterministic runs rather than
  //    zero, so "not applicable" and "measured zero" stay distinguishable.
  termination      TerminationStatus?
  turnCount        Int?
  toolCallCount    Int?
  inputTokens      Int?
  outputTokens     Int?
  /// Prompt-cache tokens. Billed at different rates from plain input, so they
  /// are kept apart rather than folded into inputTokens.
  cacheWriteTokens Int?
  cacheReadTokens  Int?
  /// Estimated USD cost. Only set when the provider reported token usage.
  estimatedCostUsd Decimal? @db.Decimal(10, 6)
  /// Schema-validated structured result produced by an adaptive run.
  outcome          Json?
  /// Guardrail trips recorded during the run (loop detection, caps, retries).
  guardrailEvents  Json?
  /// Claims in the agent's summary that no tool supported. Empty on a clean run.
  groundingIssues  String[]

  request   SalesRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]

  @@index([requestId])
  @@index([mode])
  @@map("agent_runs")
}

enum ToolStatus {
  OK
  EMPTY
  ERROR
  BLOCKED
}

enum SafetyClass {
  AUTO_SAFE
  NEEDS_REVIEW
  BLOCKED
}

/// What a tool does to the world. The agent is told this for every tool it
/// can call, and the runtime refuses mutations outside the allowed set.
enum ToolEffect {
  READ_ONLY
  DETERMINISTIC_COMPUTATION
  MUTATION
  HUMAN_GATED_MUTATION
}

model ToolCall {
  id         String      @id @default(cuid())
  runId      String
  sequence   Int
  toolName   String
  input      Json
  output     Json?
  status     ToolStatus
  safety     SafetyClass @default(AUTO_SAFE)
  effect     ToolEffect  @default(READ_ONLY)
  /// True when the model chose this call; false for pipeline-driven calls.
  modelInitiated Boolean @default(false)
  /// Operator-facing one-liner: "Checked inventory for PX-440 across 4 sites".
  summary    String
  error      String?
  startedAt  DateTime
  durationMs Int

  run      AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence Evidence[]

  @@index([runId])
  @@map("tool_calls")
}

/// Links a claim to the seeded document section or database record it came
/// from. Nothing is presented as fact in the UI without one of these.
model Evidence {
  id         String  @id @default(cuid())
  toolCallId String?
  candidateId String?
  recommendationId String?
  /// "document" | "spec" | "inventory" | "pricing" | "policy"
  kind       String
  label      String
  /// The asserted fact, e.g. "PX-440 max fluid temperature is 205 °C".
  claim      String
  sectionId  String?
  /// Structured pointer for non-document evidence (table + id).
  recordRef  String?

  toolCall       ToolCall?        @relation(fields: [toolCallId], references: [id], onDelete: Cascade)
  section        DocumentSection? @relation(fields: [sectionId], references: [id])
  candidate      RecommendationCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recommendation Recommendation?  @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@map("evidence")
}

// ───────────────────── Recommendations ──────────────────────────────

enum RecommendationOutcome {
  EXACT_MATCH
  SUBSTITUTE
  SPLIT_FULFILLMENT
  NO_VIABLE_OPTION
  INFORMATION_REQUIRED
}

model Recommendation {
  id          String                @id @default(cuid())
  requestId   String
  outcome     RecommendationOutcome
  headline    String
  rationale   String
  risk        RiskLevel
  /// Selected product, when there is one.
  productId   String?
  quantity    Int?
  createdAt   DateTime              @default(now())

  request    SalesRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  candidates RecommendationCandidate[]
  evidence   Evidence[]

  @@index([requestId])
  @@map("recommendations")
}

enum CandidateVerdict {
  RECOMMENDED
  VIABLE
  REJECTED
  REQUIRES_REVIEW
}

model RecommendationCandidate {
  id               String           @id @default(cuid())
  recommendationId String
  productId        String
  verdict          CandidateVerdict
  rank             Int
  /// Human-readable summary of why this candidate won or lost.
  reason           String
  /// Deterministic score used only for ordering viable candidates.
  score            Decimal          @db.Decimal(6, 2)
  unitPrice        Decimal?         @db.Decimal(12, 2)
  availableQty     Int?
  earliestShipDate DateTime?

  recommendation Recommendation  @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  checks         CandidateCheck[]
  evidence       Evidence[]

  @@index([recommendationId])
  @@map("recommendation_candidates")
}

enum CheckResult {
  PASS
  FAIL
  WARNING
  UNKNOWN
  NOT_APPLICABLE
}

model CandidateCheck {
  id          String      @id @default(cuid())
  candidateId String
  dimension   String
  label       String
  result      CheckResult
  severity    RuleSeverity
  requirement String
  actual      String
  detail      String
  ruleCode    String?

  candidate RecommendationCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_checks")
}

// ───────────────────────────── Quotes ───────────────────────────────

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  EXPIRED
}

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique
  requestId     String
  customerId    String
  siteId        String
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("USD")
  subtotal      Decimal     @db.Decimal(14, 2)
  discountTotal Decimal     @db.Decimal(14, 2)
  freightCost   Decimal     @db.Decimal(14, 2)
  freightService FreightService
  total         Decimal     @db.Decimal(14, 2)
  /// Internal only — never rendered in customer-facing output.
  costTotal     Decimal     @db.Decimal(14, 2)
  marginAmount  Decimal     @db.Decimal(14, 2)
  marginPct     Decimal     @db.Decimal(6, 2)
  validUntil    DateTime
  estimatedDelivery DateTime?
  terms         String
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  request  SalesRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id])
  site     CustomerSite @relation(fields: [siteId], references: [id])
  items    QuoteItem[]
  approvals Approval[]

  @@index([requestId])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String
  lineNumber  Int
  description String
  quantity    Int
  listPrice   Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  discountPct Decimal @db.Decimal(6, 2)
  /// Where the price came from: CONTRACT | PRICE_BOOK | VOLUME_BREAK | LIST | MANUAL
  priceSource String
  extended    Decimal @db.Decimal(14, 2)
  unitCost    Decimal @db.Decimal(12, 2)
  leadTimeDays Int
  /// Per-warehouse split for this line.
  allocations Json

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

// ───────────────────────────── Approvals ────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ApprovalKind {
  DELIVERY_DATE_MISS
  DISCOUNT_THRESHOLD
  MARGIN_FLOOR
  TECHNICAL_SUBSTITUTION
  COMPATIBILITY_WARNING
  EXPEDITED_FREIGHT
  LARGE_QUOTE_VALUE
  TECHNICAL_UNCERTAINTY
  SPLIT_FULFILLMENT
}

model Approval {
  id             String         @id @default(cuid())
  requestId      String
  quoteId        String?
  kind           ApprovalKind
  status         ApprovalStatus @default(PENDING)
  /// Role required to decide this approval.
  requiredRole   UserRole
  title          String
  reason         String
  proposedAction String
  commercialImpact String
  technicalImpact  String
  riskNote       String
  /// Snapshot of the numbers at the moment approval was requested.
  context        Json
  requestedById  String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime       @default(now())

  request     SalesRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote       Quote?       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestedBy User?        @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedBy   User?        @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([requestId])
  @@index([status])
  @@map("approvals")
}

// ─────────────────────── Customer response ──────────────────────────

model CustomerResponse {
  id        String   @id @default(cuid())
  requestId String
  subject   String
  body      String
  /// True once a human edited the generated draft.
  edited    Boolean  @default(false)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request SalesRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("customer_responses")
}

// ───────────────────────────── Audit ────────────────────────────────

model AuditEvent {
  id        String   @id @default(cuid())
  requestId String
  type      String
  actor     String
  actorId   String?
  summary   String
  detail    Json?
  createdAt DateTime @default(now())

  request SalesRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [actorId], references: [id])

  @@index([requestId])
  @@map("audit_events")
}
